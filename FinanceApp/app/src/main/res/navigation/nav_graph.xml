<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.financeapp.android.ui.home.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home"/>

    <fragment
        android:id="@+id/navigation_transactions"
        android:name="com.financeapp.android.ui.transactions.TransactionsFragment"
        android:label="Transacciones"
        tools:layout="@layout/fragment_transactions"/>

    <fragment
        android:id="@+id/navigation_budgets"
        android:name="com.financeapp.android.ui.budgets.BudgetsFragment"
        android:label="Presupuestos"
        tools:layout="@layout/fragment_budgets"/>

    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.financeapp.android.ui.analytics.AnalyticsFragment"
        android:label="Análisis"
        tools:layout="@layout/fragment_analytics"/>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.financeapp.android.ui.settings.SettingsFragment"
        android:label="Configuración"
        tools:layout="@layout/fragment_settings"/>

</navigation>
